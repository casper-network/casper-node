[wasm.v2.host_function_costs]
read = { cost = 0, arguments = [0, 0, 0, 0, 0, 0] }
write = { cost = 0, arguments = [0, 0, 0, 0, 0] }
remove = { cost = 0, arguments = [0, 0, 0] }
copy_input = { cost = 0, arguments = [0, 0] }
ret = { cost = 0, arguments = [0, 0] }
